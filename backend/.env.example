# 서버 설정
PORT=3000
NODE_ENV=development

# 데이터베이스 설정
DB_HOST=localhost
DB_PORT=5432
DB_USER=todolist_user
DB_PASSWORD=your_db_password_here
DB_NAME=todolist_db

# JWT 설정
JWT_SECRET=your_jwt_secret_key_here_at_least_32_chars
JWT_EXPIRES_IN=1h

# bcrypt 설정
BCRYPT_SALT_ROUNDS=10

# CORS 설정
CORS_ORIGIN=http://localhost:5173
